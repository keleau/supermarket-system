# ===== 服务配置 =====
PORT=3000

# 业务时区：影响「今日」统计、销售单号日期等（默认东八区）
TZ=Asia/Shanghai

# ===== MySQL 配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=supermarket_admin
# MySQL 会话时区，需与 TZ 对应（数字偏移）
DB_TIME_ZONE=+08:00

# ===== JWT 配置 =====
# 生产环境必须修改为至少 32 位的随机字符串，否则服务拒绝启动
JWT_SECRET=supermarket-admin-secret-key-please-change-in-production
JWT_EXPIRES_IN=24h

# ===== 跨域配置 =====
# 允许跨域的前端地址（逗号分隔）；Vite 开发服务器默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
